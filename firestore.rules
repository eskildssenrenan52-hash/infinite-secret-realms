rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity probe document (read-only)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Hardened reusable primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSandboxSave(data) {
      return data.keys().hasAll([
          'ownerId', 'heroId', 'seed', 'playerTx', 'playerTy', 'spawnTx', 'spawnTy',
          'toolTier', 'exploredSectorsCount', 'exploredSectorIndices', 'discoveredBiomes',
          'unlockedPylons', 'collectedIds', 'tileOverrides', 'materials', 'hotbar',
          'backpack', 'questsClaimed', 'worldPins', 'stats', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'heroId', 'seed', 'playerTx', 'playerTy', 'spawnTx', 'spawnTy',
          'toolTier', 'exploredSectorsCount', 'exploredSectorIndices', 'discoveredBiomes',
          'unlockedPylons', 'collectedIds', 'tileOverrides', 'materials', 'hotbar',
          'backpack', 'questsClaimed', 'worldPins', 'stats', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid
        && isValidId(data.heroId) && data.heroId.size() <= 64
        && data.seed is int && data.seed >= 0
        && data.playerTx is int && data.playerTx >= 0 && data.playerTx <= 4800
        && data.playerTy is int && data.playerTy >= 0 && data.playerTy <= 1000
        && data.spawnTx is int && data.spawnTx >= 0 && data.spawnTx <= 4800
        && data.spawnTy is int && data.spawnTy >= 0 && data.spawnTy <= 1000
        && data.toolTier is int && data.toolTier >= 1 && data.toolTier <= 6
        && data.exploredSectorsCount is int && data.exploredSectorsCount >= 0 && data.exploredSectorsCount <= 1500
        && data.exploredSectorIndices is list && data.exploredSectorIndices.size() <= 1500
        && (data.exploredSectorIndices.size() == 0 || data.exploredSectorIndices[0] is int)
        && data.discoveredBiomes is list && data.discoveredBiomes.size() <= 32
        && (data.discoveredBiomes.size() == 0 || (data.discoveredBiomes[0] is string && data.discoveredBiomes[0].size() <= 64))
        && data.unlockedPylons is list && data.unlockedPylons.size() <= 32
        && (data.unlockedPylons.size() == 0 || (data.unlockedPylons[0] is string && data.unlockedPylons[0].size() <= 64))
        && data.collectedIds is list && data.collectedIds.size() <= 3000
        && (data.collectedIds.size() == 0 || (data.collectedIds[0] is string && data.collectedIds[0].size() <= 80))
        && data.tileOverrides is map && data.tileOverrides.size() <= 4000
        && data.materials is map && data.materials.size() <= 64
        && data.hotbar is list && data.hotbar.size() <= 12
        && data.backpack is list && data.backpack.size() <= 120
        && data.questsClaimed is list && data.questsClaimed.size() <= 64
        && (data.questsClaimed.size() == 0 || (data.questsClaimed[0] is string && data.questsClaimed[0].size() <= 64))
        && data.worldPins is list && data.worldPins.size() <= 50
        && data.stats is map && data.stats.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExplorationLog(data) {
      return data.keys().hasAll([
          'ownerId', 'sectorIndex', 'sectorX', 'sectorY', 'biomeId', 'biomeLabel', 'discoveredAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'sectorIndex', 'sectorX', 'sectorY', 'biomeId', 'biomeLabel', 'discoveredAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.sectorIndex is int && data.sectorIndex >= 0 && data.sectorIndex <= 2000
        && data.sectorX is int && data.sectorX >= 0 && data.sectorX <= 120
        && data.sectorY is int && data.sectorY >= 0 && data.sectorY <= 40
        && data.biomeId is string && data.biomeId.size() >= 1 && data.biomeId.size() <= 64
        && data.biomeLabel is string && data.biomeLabel.size() >= 1 && data.biomeLabel.size() <= 100
        && data.discoveredAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;

      match /sandboxSaves/{saveId} {
        allow get: if isValidId(userId) && isValidId(saveId) && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(saveId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSandboxSave(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(saveId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && isValidSandboxSave(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().seed == existing().seed
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'heroId', 'playerTx', 'playerTy', 'spawnTx', 'spawnTy', 'toolTier',
            'exploredSectorsCount', 'exploredSectorIndices', 'discoveredBiomes',
            'unlockedPylons', 'collectedIds', 'tileOverrides', 'materials',
            'hotbar', 'backpack', 'questsClaimed', 'worldPins', 'stats', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /explorationLogs/{sectorKey} {
        allow get: if isValidId(userId) && isValidId(sectorKey) && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(sectorKey)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidExplorationLog(incoming())
          && incoming().discoveredAt == request.time;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
